      "maximumCycleAgeHours": 12,
      "maximumLeadHours": 120,
      "availability": [{"through": 120, "every": 1}],
      "sampling": {"baseIntervalHours": 3},
      "variables": ["TMP", "DPT", "UGRD", "VGRD", "GUST", "APCP", "PRATE", "PRMSL", "TCDC", "VIS", "CAPE", "CIN", "PWAT", "TMAX", "TMIN", "RH", "HGT"],
      "levels": ["2_m_above_ground", "10_m_above_ground", "surface", "mean_sea_level", "entire_atmosphere", "entire_atmosphere_(considered_as_a_single_layer)", "180-0_mb_above_ground", "255-0_mb_above_ground", "925_mb", "850_mb", "700_mb", "500_mb"],
      "requiredIndexPatterns": [":TMP:2 m above ground:", ":UGRD:10 m above ground:", ":VGRD:10 m above ground:"],
      "requiredShortNames": ["2t", "10u", "10v"]
    },
    "gefs": {
      "enabled": true,
      "required": true,
      "provider": "noaa-nomads",
      "label": "GEFS 0.5 degree mean and spread",
      "product": "pgrb2a-0p50",
      "filter": "filter_gefs_atmos_0p50a.pl",
      "archiveModel": "gens",
      "directoryTemplate": "/gefs.{date}/{hour:02d}/atmos/pgrb2ap5",
      "components": [
        {"variant": "mean", "fileTemplate": "geavg.t{hour:02d}z.pgrb2a.0p50.f{forecastHour:03d}"},
        {"variant": "spread", "fileTemplate": "gespr.t{hour:02d}z.pgrb2a.0p50.f{forecastHour:03d}"}
      ],
      "cycles": [0, 6, 12, 18],
      "lookbackCycles": 8,
      "maximumCycleAgeHours": 12,
      "maximumLeadHours": 120,
      "availability": [{"through": 120, "every": 3}],
      "sampling": {"baseIntervalHours": 6},
      "variables": ["TMP", "RH", "UGRD", "VGRD", "APCP", "PRMSL", "TCDC", "CAPE", "CIN", "PWAT", "TMAX", "TMIN", "HGT", "VVEL"],
      "levels": ["2_m_above_ground", "10_m_above_ground", "surface", "mean_sea_level", "entire_atmosphere", "entire_atmosphere_(considered_as_a_single_layer)", "180-0_mb_above_ground", "925_mb", "850_mb", "700_mb", "500_mb"],
      "requiredIndexPatterns": [":TMP:2 m above ground:"],
      "requiredShortNames": ["2t"]
    },
    "ecmwf": {
      "enabled": true,
      "required": true,
      "provider": "ecmwf-open-data",
      "label": "ECMWF IFS Open Data 0.25 degree",
      "product": "ifs-0p25",
      "variant": "deterministic",
      "model": "ifs",
      "resolution": "0p25",
      "stream": "oper",
      "type": "fc",
      "sources": ["ecmwf", "aws", "azure", "google"],
      "indexRoot": "https://data.ecmwf.int/forecasts",
      "cycles": [0, 6, 12, 18],
      "lookbackCycles": 8,
      "maximumCycleAgeHours": 12,
      "maximumLeadHours": 144,
      "availability": [{"through": 144, "every": 3}],
      "sampling": {"baseIntervalHours": 3},
      "products": [
        {
          "name": "surface",
          "levtype": "sfc",
          "intervalHours": 3,
          "parameters": ["2t", "2d", "10u", "10v", "10fg", "msl", "tp", "tprate", "tcc", "mucape", "ptype", "mx2t3", "mn2t3", "tcwv"],
          "requiredParameters": ["2t", "2d", "10u", "10v", "msl", "tp", "tcc"]
        },
        {
          "name": "pressure",
          "levtype": "pl",
          "intervalHours": 6,
          "parameters": ["t", "r", "u", "v", "w", "gh"],
          "levels": [925, 850, 700, 500],
          "requiredParameters": ["t", "r", "u", "v", "gh"]
        }
      ],
      "attribution": {
